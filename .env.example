# Copy to .env; start.ps1 generates LOCAL_API_TOKEN automatically if blank.
LOCAL_API_TOKEN=
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# Optional: set these here, or save them in the extension's settings page.
BAIDU_APP_ID=
BAIDU_SECRET_KEY=
BAIDU_INTERVAL=1.05
# Optional: directory containing CUDA 12 / cuDNN 9 DLLs on Windows.
CUDA_DLL_DIRECTORY=

